# MeiliSearch — Connects to the shared bettergovph search infrastructure
VITE_MEILISEARCH_HOST=https://search2.bettergov.ph
VITE_MEILISEARCH_PORT=443
VITE_MEILISEARCH_API_KEY=

# Coming-soon gate — when "true", every route renders the "in development"
# holding page instead of the portal. Bypass it locally or in production with
# ?preview=1 (and clear the bypass with ?preview=0).
# Set to "false" or remove the line to take the portal public.
VITE_COMING_SOON=true
